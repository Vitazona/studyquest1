# Study Quest Environment Configuration Example
# Copy this file to .env and fill in your values

PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/studyquest

# Database Name
MONGODB_DB=studyquest

# Secret key used for signing session cookies (generate a secure random 32+ byte string)
SESSION_SECRET=replace-this-with-a-long-secure-random-secret-key-at-least-32-chars

# Maximum file upload size for curriculum in megabytes
MAX_FILE_SIZE_MB=15

