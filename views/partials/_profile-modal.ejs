<dialog class="profile-dialog" id="profileDialog" aria-labelledby="profileDialogName">
    <div class="profile-dialog-content">
        <div class="profile-avatar large-avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="8" r="4" fill="currentColor"/>
                <path d="M4.5 21c0-4.2 3.1-7 7.5-7s7.5 2.8 7.5 7" fill="currentColor"/>
            </svg>
        </div>
        <span class="profile-dialog-eyebrow">YOUR STUDY QUEST</span>
        <h2 id="profileDialogName"><%= typeof user !== 'undefined' && user.username ? user.username : 'username' %></h2>
        <p>LEVEL 0 · STUDY EXPLORER</p>
        <button class="profile-dialog-close" id="closeProfileButton" type="button">CLOSE</button>
        <button class="btn-logout" id="logoutButton" type="button" style="margin-top: 10px; width: 100%; padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(220,53,69,0.2); color: inherit; cursor: pointer; font-weight: bold;">LOG OUT</button>
    </div>
</dialog>

